# Copy to .env and fill in. Never commit .env.
# Wrap any value containing $ or # in single quotes, e.g. ADMIN_PASSWORD='pa$$word#1'
# (otherwise Docker Compose expands $ and may cut the value at #).

# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Pick your own admin username, not "admin" (3-32 characters from a-z 0-9 _ . -).
ADMIN_USERNAME=
# Use a long random password, e.g.:
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"
# At least 8 characters. Re-applied on every container start.
ADMIN_PASSWORD=
