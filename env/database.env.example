# Copy to env/database.env and fill in. Never commit env/database.env.
# Wrap any value containing $ or # in single quotes, e.g. PASSWORD='pa$$word#1'
# (otherwise Docker Compose expands $ and may cut the value at #).

# The PostgreSQL server, and an EXISTING database and user on it. The user needs
# CREATE on schema public. The tables are created by the migrations on every start.
HOST=
PORT=5432
# The database user name.
ADMIN=
DATABASE=
PASSWORD=
