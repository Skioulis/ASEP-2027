# ── Secrets ──────────────────────────────────────────────────────────────────
# Real env files live in env/ (app.env, database.env); only the *.example
# templates there are tracked. Never commit credentials.
env/*
!env/*.example
.env
*.env

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/

# ── Virtual environments ─────────────────────────────────────────────────────
.venv/
venv/

# ── Local databases and backups ──────────────────────────────────────────────
# SQLite is only used for local development and tests; production is Postgres.
*.db
*.db-wal
*.db-shm
*.db-journal
instance/
# pg_dump backups (they contain password hashes)
*.dump
*.sql.gz

# ── Editors and tools ────────────────────────────────────────────────────────
.idea/
.vscode/
.junie/
.superpowers/
.claude/settings.local.json
.~lock.*#
.DS_Store
