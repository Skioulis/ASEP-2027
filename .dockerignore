.venv/
.git/
.gitignore
.idea/
.claude/
.superpowers/
.junie/
__pycache__/
**/__pycache__/
*.pyc
.pytest_cache/
.env
# secrets: env_file passes them in at run time, they must never enter the image
env/
# local development database; production uses PostgreSQL
*.db
*.db-journal
*.db-wal
*.db-shm
# database backups contain password hashes and must never enter the image
*.dump
*.sql.gz
# source PDFs and design docs are not needed at runtime
themata/
docs/
